# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/resume_matcher

# ---- Security ----
# Optional. When set, every /api request must include header "X-API-Key: <value>".
# Set the same value as VITE_API_KEY in frontend/.env
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Uploads ----
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_BATCH=50

# ---- NLP ----
SPACY_MODEL=en_core_web_sm
EMBEDDING_MODEL=all-MiniLM-L6-v2
# sentence-transformers (default) | tfidf (lightweight offline fallback)
EMBEDDING_BACKEND=sentence-transformers

# ---- Scoring weights (normalized to sum to 1) ----
WEIGHT_SKILLS=0.40
WEIGHT_SEMANTIC=0.30
WEIGHT_EXPERIENCE=0.20
WEIGHT_EDUCATION=0.10
MANDATORY_SKILL_SHARE=0.75
RELATED_SKILL_CREDIT=0.5
SEMANTIC_SKILL_THRESHOLD=0.70
